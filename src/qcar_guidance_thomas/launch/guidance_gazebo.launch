<launch>
    <!-- ================================================================
         Full Gazebo simulation with this package's guidance (v5).

           roslaunch qcar_guidance_thomas guidance_gazebo.launch
           roslaunch qcar_guidance_thomas guidance_gazebo.launch track:=Track3
           roslaunch qcar_guidance_thomas guidance_gazebo.launch laps:=5

         track: Track1 | Track2 | Track3 | CircleTrack | Figure8

         Self-contained: does NOT depend on the qcar_gazebo *Example.launch
         files. Topic wiring follows the team's Track1ExampleThomas setup:
           /odometry/local    smooth wheels+IMU (nav_filter_node, remapped)
                              -> used by guidance AND control
           /odometry/filtered EKF-SLAM pose (map frame, jumps on updates)
                              -> used by guidance only, to align the race
                                 line (built from /cone_map) to /odometry/local
         ================================================================ -->
    <arg name="track" default="Track1"/>
    <arg name="laps"  default="0"/>
    <arg name="debug" default="true"/>

    <arg name="x" default="$(eval -4.3 if arg('track')=='Track1' else (-4.35 if arg('track')=='Track2' else (4.6 if arg('track')=='Track3' else (6.8 if arg('track')=='CircleTrack' else -2.5))))"/>
    <arg name="y" default="$(eval 3.0 if arg('track')=='Track1' else (3.5 if arg('track')=='Track2' else (11.5 if arg('track')=='Track3' else (-0.2 if arg('track')=='CircleTrack' else 3.0))))"/>
    <arg name="yaw" default="$(eval 1.57 if arg('track')=='CircleTrack' else (-1.5707963 if arg('track')=='Figure8' else -3.14))"/>

    <param name="robot_description" command="$(find xacro)/xacro $(find qcar_gazebo)/urdf/qcar_model.xacro"/>
    <rosparam file="$(find qcar_controlplugin)/config/qcar_controlplugin.yaml" command="load"/>

    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher"/>
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"
          respawn="false" output="screen">
        <remap from="/joint_states" to="/qcar/joint_states"/>
    </node>

    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find qcar_gazebo)/worlds/$(arg track).world"/>
        <arg name="gui" value="true"/>
        <arg name="verbose" value="true"/>
    </include>

    <node name="spawn_qcar" pkg="gazebo_ros" type="spawn_model" output="screen"
          args="-urdf -param robot_description -model qcar -x $(arg x) -y $(arg y) -z 0 -R 0 -P 0 -Y $(arg yaw)"/>

    <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
          output="screen" ns="/qcar" args="base_fr_controller base_fl_controller joint_state_controller"/>

    <!-- Guidance (this package) -->
    <node name="guidance_node" pkg="qcar_guidance_thomas" type="online_guidance_node.py" output="screen">
        <rosparam command="load" file="$(find qcar_guidance_thomas)/config/guidance_params.yaml"/>
        <param name="total_laps" value="$(arg laps)"/>
        <param name="local_odom_topic" value="/odometry/local"/>
        <param name="map_odom_topic" value="/odometry/filtered"/>
    </node>

    <!-- Control (Luke) on the smooth local odometry -->
    <node name="control_node" pkg="qcar_control" type="example_control_node" output="screen">
        <remap from="/odometry/filtered" to="/odometry/local"/>
    </node>

    <!-- Navigation (Ethan): SLAM + cone detection + fusion (+ RViz) -->
    <include file="$(find qcar_navigation)/launch/cone_slam.launch"/>
    <include file="$(find qcar_navigation)/launch/camera_vision.launch">
        <arg name="debug" value="$(arg debug)"/>
    </include>

    <!-- Smooth local odometry: wheels + IMU, no landmark corrections -->
    <group>
        <remap from="/odometry/filtered" to="/odometry/local"/>
        <include file="$(find qcar_navigation)/launch/EKF_navigation.launch"/>
    </group>

    <node name="path_visualizer_node" pkg="qcar_guidance_thomas" type="path_visualizer_node.py" output="screen"/>
    <node name="trajectory_logger_node" pkg="qcar_guidance_thomas" type="trajectory_logger_node.py" output="screen"/>
</launch>
