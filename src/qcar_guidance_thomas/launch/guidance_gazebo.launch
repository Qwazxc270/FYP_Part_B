<launch>
    <!-- Full Gazebo simulation with this package's guidance node.

         Runs Track1ExampleThomas.launch (generated by
         extras/setup_workspace.sh from the stock Track1Example.launch, with
         the guidance node swapped to qcar_guidance_thomas), plus the
         visualiser and CSV logger.

         NOTE (v2): the camera_rgb_optical static transform that used to live
         here has been REMOVED. Ethan's qcar_model.xacro now defines the
         optical frame properly (camera_rgb_optical_joint, rpy -1.5708 0
         -1.5708), so publishing it here too would duplicate the frame and
         spam TF_REPEATED_DATA warnings.

         If you ever run against an OLDER base that lacks that URDF joint,
         re-add this line:
         <node pkg="tf" type="static_transform_publisher" name="camera_optical_tf"
               args="0 0 0 -1.5707963 0 -1.5707963 camera_rgb camera_rgb_optical 50"/>
    -->

    <include file="$(find qcar_gazebo)/launch/Track1ExampleThomas.launch"/>

    

    <node name="path_visualizer_node" pkg="qcar_guidance_thomas"
          type="path_visualizer_node.py" output="screen"/>

    <node name="trajectory_logger_node" pkg="qcar_guidance_thomas"
          type="trajectory_logger_node.py" output="screen"/>
</launch>
